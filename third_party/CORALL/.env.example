# ─────────────────────────────────────────────────────────────────────────────
# CORALL LLM Provider Configuration — EXAMPLE (safe to commit)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real API keys.
#   cp .env.example .env
# The actual .env is gitignored and should never be committed.
# ─────────────────────────────────────────────────────────────────────────────

LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=50

# Anthropic Claude (only if LLM_PROVIDER=claude)
CLAUDE_API_KEY=REPLACE_WITH_YOUR_CLAUDE_KEY
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_TEMPERATURE=0.1
CLAUDE_MAX_TOKENS=50
